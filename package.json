{
  "name": "@comcent/root",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev:sip-test-tools-ui": "dotenv -- npm run dev --prefix packages/sip-test-tools-ui -- --host 0.0.0.0 --port 5175",
    "build:web-app": "npm run build --prefix packages/web-app",
    "start:web-app": "dotenv -- node packages/web-app/build/index.js",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky install; fi",
    "lint": "eslint . --ext .vue,.svelte,.html,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "stage-format": "node tools/stage-format.mjs",
    "lint-staged": "lint-staged",
    "eslint-fix": "eslint --fix",
    "test:e2e": "dotenvx run --env-file=.env.e2e -- npm run test --prefix e2e",
    "test:e2e:telephony": "dotenvx run --env-file=.env.e2e -- npm run test:telephony --prefix e2e",
    "test:e2e:html": "dotenvx run --env-file=.env.e2e -- npm run test:html --prefix e2e",
    "test:e2e:telephony:html": "dotenvx run --env-file=.env.e2e -- npm run test:telephony:html --prefix e2e",
    "test:e2e:telephony:sipp:build": "docker compose -f docker-compose-e2e.yaml --env-file .env.e2e -p comcent-e2e build sipp sipp-uas",
    "test:e2e:stack:up": "docker compose -f docker-compose-e2e.yaml --env-file .env.e2e -p comcent-e2e up -d --build",
    "test:e2e:stack:down": "docker compose -f docker-compose-e2e.yaml --env-file .env.e2e -p comcent-e2e down --remove-orphans -v",
    "test:e2e:stack:logs": "docker compose -f docker-compose-e2e.yaml --env-file .env.e2e -p comcent-e2e logs --tail=3000",
    "test:vscode": "code e2e",
    "test": "npm run test --prefix packages/web-app && npm run test --prefix packages/sip-test-tools-ui",
    "docker:db:migrate": "docker compose exec -w /app server mix ecto.migrate",
    "check:elixir": "cd server && mix compile --warnings-as-errors && cd ..",
    "install:rollup-platform": "./tools/install-rollup-platform.sh"
  },
  "lint-staged": {
    "*.{js,ts,html,css,vue,svelte}": [
      "npm run eslint-fix",
      "npm run stage-format"
    ],
    "server/**/*.{ex,exs}": [
      "./tools/format-elixir-staged.sh"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comcent-io/comcent-ce.git"
  },
  "author": "",
  "workspaces": [
    "packages/sip-test-tools-ui",
    "packages/tools"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.2.4"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.28.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.16.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "natural-compare-lite": "^1.4.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "marked": "^16.4.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.46.2",
    "@rollup/rollup-darwin-x64": "^4.46.2",
    "@rollup/rollup-linux-x64-gnu": "^4.46.2"
  }
}
